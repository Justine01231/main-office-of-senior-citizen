{
  "name": "office-seniors-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "bun run --filter @office-seniors/mobile dev",
    "admin": "bun run --filter @office-seniors/admin dev",
    "build:admin": "bun run --filter @office-seniors/admin build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "bun@1.1.0"
}
